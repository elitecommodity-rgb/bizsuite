<%- include('../partials/head', { title }) %>
<div class="auth-wrap">
  <div class="auth-card">
    <div class="auth-brand"><div class="mark">B</div><div class="name">BizSuite</div></div>
    <h1>Welcome back</h1>
    <p class="auth-sub">Log in to your business dashboard.</p>
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form method="POST" action="/login">
      <div class="form-row">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" value="<%= form.email || '' %>" required autofocus />
      </div>
      <div class="form-row">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required />
      </div>
      <button type="submit" class="btn btn-block">Log in</button>
    </form>
    <div class="auth-foot">New here? <a href="/signup">Create a business account</a></div>
  </div>
</div>
<%- include('../partials/foot') %>
