<%- include('../partials/head', { title }) %>
<%- include('../partials/app-start', { title }) %>
  <div class="page-head"><h1><%= title %></h1></div>
  <div class="card" style="max-width:640px;">
    <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
    <form method="POST" action="<%= item.id ? '/stock/' + item.id : '/stock' %>" enctype="multipart/form-data">
      <div class="form-grid">
        <div class="form-row">
          <label>Item name</label>
          <input type="text" name="name" value="<%= item.name || '' %>" required />
        </div>
        <div class="form-row">
          <label>SKU (optional)</label>
          <input type="text" name="sku" value="<%= item.sku || '' %>" />
        </div>
        <div class="form-row">
          <label>Category</label>
          <input type="text" name="category" value="<%= item.category || '' %>" placeholder="e.g. Frame, Board, Ingredient" />
        </div>
        <div class="form-row">
          <label>Unit</label>
          <input type="text" name="unit" value="<%= item.unit || 'unit' %>" placeholder="e.g. each, kg, box" />
        </div>
        <% if (!item.id) { %>
        <div class="form-row">
          <label>Starting quantity on hand</label>
          <input type="number" step="any" name="quantityOnHand" value="<%= item.quantityOnHand || 0 %>" />
        </div>
        <% } %>
        <div class="form-row">
          <label>Reorder level (low-stock alert)</label>
          <input type="number" step="any" name="reorderLevel" value="<%= item.reorder_level != null ? item.reorder_level : (item.reorderLevel || 0) %>" />
        </div>
        <div class="form-row">
          <label>Unit cost</label>
          <input type="number" step="0.01" name="unitCost" value="<%= item.unit_cost != null ? item.unit_cost : (item.unitCost || 0) %>" />
        </div>
        <div class="form-row">
          <label>Unit sale price</label>
          <input type="number" step="0.01" name="unitPrice" value="<%= item.unit_price != null ? item.unit_price : (item.unitPrice || 0) %>" />
        </div>
      </div>
      <div class="form-row">
        <label>Photo (optional)</label>
        <input type="file" name="photo" accept="image/*" />
        <% if (item.photo_url) { %><img src="<%= item.photo_url %>" style="max-width:120px;border-radius:8px;margin-top:8px;display:block;" /><% } %>
      </div>
      <div class="form-actions">
        <button type="submit" class="btn"><%= item.id ? 'Save changes' : 'Add item' %></button>
        <a href="<%= item.id ? '/stock/' + item.id : '/stock' %>" class="btn btn-outline">Cancel</a>
      </div>
    </form>
  </div>
<%- include('../partials/app-end') %>
<%- include('../partials/foot') %>
