<%- include('../partials/head', { title }) %>
<%- include('../partials/app-start', { title }) %>
  <div class="page-head">
    <div>
      <h1>Invoice <%= invoice.number %></h1>
      <div class="sub">
        <a href="/clients/<%= invoice.client_id %>"><%= invoice.client_name %></a> ·
        <% if (invoice.status === 'PAID') { %><span class="badge badge-success">Paid</span>
        <% } else if (invoice.status === 'OVERDUE') { %><span class="badge badge-danger">Overdue</span>
        <% } else if (invoice.status === 'PARTIALLY_PAID') { %><span class="badge badge-warn">Partially paid</span>
        <% } else { %><span class="badge badge-muted"><%= invoice.status %></span><% } %>
      </div>
    </div>
    <div class="tag-row">
      <form method="POST" action="/invoices/<%= invoice.id %>/send"><button type="submit" class="btn btn-outline btn-sm">✉ Email to client</button></form>
      <% if (invoice.status !== 'CANCELLED' && invoice.status !== 'PAID') { %>
        <form method="POST" action="/invoices/<%= invoice.id %>/status" onsubmit="return confirm('Cancel this invoice?');"><input type="hidden" name="status" value="CANCELLED" /><button class="btn btn-outline btn-sm">Cancel</button></form>
      <% } %>
    </div>
  </div>

  <div class="detail-grid">
    <div>
      <div class="card">
        <div class="card-title">Line items</div>
        <div class="table-wrap">
          <table>
            <thead><tr><th>Description</th><th class="right">Qty</th><th class="right">Unit price</th><th class="right">Total</th></tr></thead>
            <tbody>
              <% lines.forEach(function(l) { %>
              <tr><td><%= l.description %></td><td class="right"><%= l.quantity %></td><td class="right"><%= tenant.currency %> <%= l.unit_price.toFixed(2) %></td><td class="right"><%= tenant.currency %> <%= l.line_total.toFixed(2) %></td></tr>
              <% }) %>
            </tbody>
          </table>
        </div>
        <div class="totals-box">
          <div class="kv"><span class="k">Subtotal</span><span class="v"><%= tenant.currency %> <%= invoice.subtotal.toFixed(2) %></span></div>
          <div class="kv"><span class="k">Tax (<%= invoice.tax_rate_pct %>%)</span><span class="v"><%= tenant.currency %> <%= invoice.tax_amount.toFixed(2) %></span></div>
          <div class="kv"><span class="k">Total</span><span class="v"><%= tenant.currency %> <%= invoice.total.toFixed(2) %></span></div>
          <div class="kv"><span class="k">Paid so far</span><span class="v"><%= tenant.currency %> <%= invoice.amount_paid.toFixed(2) %></span></div>
          <div class="kv grand"><span class="k">Balance due</span><span class="v" style="<%= balance > 0 ? 'color:var(--danger)' : '' %>"><%= tenant.currency %> <%= balance.toFixed(2) %></span></div>
        </div>
      </div>

      <div class="card">
        <div class="card-title">Payments</div>
        <% if (!payments.length) { %><div class="table-empty">No payments recorded yet.</div><% } else { %>
        <div class="table-wrap"><table>
          <thead><tr><th>Date</th><th>Method</th><th class="right">Amount</th></tr></thead>
          <tbody><% payments.forEach(function(p) { %>
            <tr><td class="muted"><%= new Date(p.paid_at + 'Z').toLocaleDateString() %></td><td class="muted"><%= p.method || '—' %></td><td class="right"><%= tenant.currency %> <%= p.amount.toFixed(2) %></td></tr>
          <% }) %></tbody>
        </table></div>
        <% } %>
        <% if (balance > 0 && invoice.status !== 'CANCELLED') { %>
        <form method="POST" action="/invoices/<%= invoice.id %>/payment" style="margin-top:14px;">
          <div class="form-grid">
            <div class="form-row"><label>Amount</label><input type="number" step="0.01" min="0.01" max="<%= balance %>" name="amount" required /></div>
            <div class="form-row"><label>Method</label><input type="text" name="method" placeholder="EFT, Card, Cash…" /></div>
          </div>
          <button type="submit" class="btn btn-sm">Record payment</button>
        </form>
        <% } %>
      </div>
    </div>

    <div>
      <div class="card">
        <div class="kv"><span class="k">Client</span><span class="v"><a href="/clients/<%= invoice.client_id %>"><%= invoice.client_name %></a></span></div>
        <div class="kv"><span class="k">Issued</span><span class="v"><%= new Date(invoice.issue_date + 'Z').toLocaleDateString() %></span></div>
        <div class="kv"><span class="k">Due</span><span class="v"><%= invoice.due_date ? new Date(invoice.due_date).toLocaleDateString() : '—' %></span></div>
        <% if (invoice.order_id) { %><div class="kv"><span class="k">Order</span><span class="v"><a href="/orders/<%= invoice.order_id %>">View order</a></span></div><% } %>
        <% if (invoice.notes) { %><div style="margin-top:12px;"><div class="muted" style="font-size:0.78rem;margin-bottom:4px;">NOTES</div><%= invoice.notes %></div><% } %>
      </div>
    </div>
  </div>
<%- include('../partials/app-end') %>
<%- include('../partials/foot') %>
